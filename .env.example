# Required: server-side Groq API key for AI answers. Never expose this in client code.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq chat model used by the API route.
GROQ_MODEL=llama-3.3-70b-versatile

# Required: Supabase project values for real auth and database reads.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required for saving AI chat history from the backend. Keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: override the client API base path. Defaults to /api.
# NEXT_PUBLIC_API_URL=/api
